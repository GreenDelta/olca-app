{
  "name": "get_data",
  "title": "Get a data set",
  "description": "Returns the complete data set with the given type and @id (or name, if no @id is given) in the openLCA JSON-LD format. Use this to inspect a data set in detail or as a template for creating similar data sets.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "Project",
          "ImpactMethod",
          "ImpactCategory",
          "ProductSystem",
          "Process",
          "Flow",
          "FlowProperty",
          "UnitGroup",
          "Actor",
          "Source",
          "Category",
          "Location",
          "SocialIndicator",
          "Currency",
          "Parameter",
          "DQSystem",
          "Result",
          "Epd"
        ],
        "description": "The type of the data set."
      },
      "id": {
        "type": "string",
        "description": "The @id of the data set."
      },
      "name": {
        "type": "string",
        "description": "The name of the data set; used when no @id is given."
      }
    },
    "required": [
      "type"
    ]
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "openWorldHint": false
  }
}
